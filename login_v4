
<!DOCTYPE html>
<html>
<head>
    <base target="_top">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>N.E.X.U.S. - Login</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&display=swap');

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Orbitron', sans-serif;
            background: linear-gradient(135deg, #0a0e27 0%, #1a1a2e 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            position: relative;
        }

        /* Grid tech no fundo */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: 
                linear-gradient(rgba(0, 217, 255, 0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 217, 255, 0.03) 1px, transparent 1px);
            background-size: 50px 50px;
            pointer-events: none;
        }

        /* Container principal */
        .login-container {
            position: relative;
            z-index: 10;
            background: linear-gradient(135deg, rgba(22, 33, 62, 0.95), rgba(26, 26, 46, 0.95));
            border: 2px solid #00d9ff;
            border-radius: 20px;
            padding: 60px;
            box-shadow: 
                0 0 40px rgba(0, 217, 255, 0.3),
                inset 0 0 50px rgba(0, 0, 0, 0.3);
            max-width: 500px;
            width: 90%;
            text-align: center;
        }

        /* Logo 8-16 bits */
        .logo-container {
            margin-bottom: 30px;
            position: relative;
        }

        .pixel-art {
            width: 180px;
            height: 180px;
            margin: 0 auto 25px;
            position: relative;
            image-rendering: pixelated;
            image-rendering: -moz-crisp-edges;
            image-rendering: crisp-edges;
        }

        /* Espada na balança sobre livros - estilo 8-bit */
        .pixel-art svg {
            width: 100%;
            height: 100%;
        }

        /* Título N.E.X.U.S. */
        .logo-title {
            font-size: 48px;
            font-weight: 900;
            color: #00d9ff;
            letter-spacing: 8px;
            margin-bottom: 8px;
            text-shadow: 0 0 20px rgba(0, 217, 255, 0.5);
        }

        .logo-acronym {
            font-size: 13px;
            color: #a8b2d1;
            letter-spacing: 2px;
            line-height: 1.6;
            margin-bottom: 5px;
        }

        .logo-subtitle {
            font-size: 11px;
            color: #5a7a8a;
            letter-spacing: 1px;
            font-style: italic;
        }

        /* Linha divisória */
        .divider {
            height: 1px;
            background: linear-gradient(90deg, transparent, #00d9ff, transparent);
            margin: 35px 0;
        }

        /* Descrição */
        .description {
            color: #a8b2d1;
            font-size: 13px;
            line-height: 1.8;
            margin-bottom: 40px;
            text-align: justify;
        }

        /* Botão de login */
        .login-btn {
            width: 100%;
            padding: 18px;
            background: linear-gradient(135deg, #e94560, #c0392b);
            border: 2px solid #00d9ff;
            color: white;
            font-family: 'Orbitron', sans-serif;
            font-size: 16px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 2px;
            cursor: pointer;
            border-radius: 10px;
            transition: all 0.3s;
            box-shadow: 0 5px 20px rgba(233, 69, 96, 0.4);
        }

        .login-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 30px rgba(233, 69, 96, 0.6);
        }

        .login-btn:active {
            transform: translateY(-1px);
        }

        .login-icon {
            margin-right: 10px;
            font-size: 18px;
        }

        /* Loading */
        .loading {
            display: none;
            margin-top: 25px;
        }

        .loading.active {
            display: block;
        }

        .spinner {
            border: 3px solid rgba(0, 217, 255, 0.1);
            border-top: 3px solid #00d9ff;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            animation: spin 1s linear infinite;
            margin: 0 auto 12px;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .loading-text {
            color: #00d9ff;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* Features */
        .features {
            margin-top: 35px;
            text-align: left;
        }

        .feature-item {
            display: flex;
            align-items: flex-start;
            margin-bottom: 12px;
            font-size: 11px;
            color: #a8b2d1;
            line-height: 1.5;
        }

        .feature-icon {
            color: #00d9ff;
            margin-right: 10px;
            font-size: 14px;
            min-width: 20px;
        }

        /* Footer */
        .footer {
            margin-top: 35px;
            padding-top: 25px;
            border-top: 1px solid rgba(0, 217, 255, 0.1);
            font-size: 10px;
            color: #5a7a8a;
            line-height: 1.6;
        }

        .footer strong {
            color: #00d9ff;
        }

        /* Responsive */
        @media (max-width: 600px) {
            .login-container {
                padding: 40px 30px;
            }

            .logo-title {
                font-size: 36px;
                letter-spacing: 5px;
            }

            .pixel-art {
                width: 140px;
                height: 140px;
            }
        }
    </style>
</head>
<body>
    <div class="login-container">
        <!-- Logo 8-bit -->
        <div class="logo-container">
            <div class="pixel-art">
                <svg viewBox="0 0 180 180" xmlns="http://www.w3.org/2000/svg">
                    <!-- Livros empilhados (base) -->
                    <!-- Livro 1 (inferior) - Vermelho -->
                    <rect x="20" y="140" width="140" height="15" fill="#8B0000" stroke="#000" stroke-width="2"/>
                    <rect x="25" y="143" width="5" height="9" fill="#6B0000"/>
                    <line x1="20" y1="140" x2="160" y2="140" stroke="#000" stroke-width="2"/>
                    
                    <!-- Livro 2 (meio-baixo) - Azul escuro -->
                    <rect x="30" y="125" width="120" height="15" fill="#0f3460" stroke="#000" stroke-width="2"/>
                    <rect x="35" y="128" width="5" height="9" fill="#0a2342"/>
                    <line x1="30" y1="125" x2="150" y2="125" stroke="#000" stroke-width="2"/>
                    
                    <!-- Livro 3 (meio-cima) - Verde escuro -->
                    <rect x="35" y="110" width="110" height="15" fill="#1a4d2e" stroke="#000" stroke-width="2"/>
                    <rect x="40" y="113" width="5" height="9" fill="#0f3a1f"/>
                    <line x1="35" y1="110" x2="145" y2="110" stroke="#000" stroke-width="2"/>
                    
                    <!-- Livro 4 (superior) - Dourado -->
                    <rect x="40" y="95" width="100" height="15" fill="#8B7355" stroke="#000" stroke-width="2"/>
                    <rect x="45" y="98" width="5" height="9" fill="#6B5335"/>
                    <line x1="40" y1="95" x2="140" y2="95" stroke="#000" stroke-width="2"/>
                    
                    <!-- Balança (base sobre os livros) -->
                    <!-- Pedestal -->
                    <rect x="85" y="75" width="10" height="20" fill="#5a5a5a" stroke="#000" stroke-width="2"/>
                    <rect x="75" y="85" width="30" height="6" fill="#4a4a4a" stroke="#000" stroke-width="1.5"/>
                    
                    <!-- Haste vertical -->
                    <rect x="88" y="45" width="4" height="30" fill="#6a6a6a" stroke="#000" stroke-width="1.5"/>
                    
                    <!-- Barra horizontal da balança -->
                    <rect x="60" y="43" width="60" height="4" fill="#7a7a7a" stroke="#000" stroke-width="1.5"/>
                    
                    <!-- Pratos da balança -->
                    <!-- Prato esquerdo -->
                    <line x1="70" y1="45" x2="65" y2="55" stroke="#6a6a6a" stroke-width="1.5"/>
                    <line x1="70" y1="45" x2="75" y2="55" stroke="#6a6a6a" stroke-width="1.5"/>
                    <rect x="55" y="55" width="30" height="4" fill="#8a8a8a" stroke="#000" stroke-width="1.5"/>
                    
                    <!-- Prato direito -->
                    <line x1="110" y1="45" x2="105" y2="55" stroke="#6a6a6a" stroke-width="1.5"/>
                    <line x1="110" y1="45" x2="115" y2="55" stroke="#6a6a6a" stroke-width="1.5"/>
                    <rect x="95" y="55" width="30" height="4" fill="#8a8a8a" stroke="#000" stroke-width="1.5"/>
                    
                    <!-- Espada enfincada (atravessando a balança) -->
                    <!-- Lâmina -->
                    <rect x="87" y="10" width="6" height="60" fill="#c0c0c0" stroke="#000" stroke-width="2"/>
                    <polygon points="90,10 85,5 95,5" fill="#d0d0d0" stroke="#000" stroke-width="2"/>
                    
                    <!-- Guarda (cruzeta) -->
                    <rect x="75" y="38" width="30" height="5" fill="#8B7355" stroke="#000" stroke-width="1.5"/>
                    
                    <!-- Cabo -->
                    <rect x="86" y="43" width="8" height="20" fill="#4a3728" stroke="#000" stroke-width="1.5"/>
                    
                    <!-- Pomo -->
                    <circle cx="90" cy="65" r="5" fill="#8B7355" stroke="#000" stroke-width="1.5"/>
                    
                    <!-- Brilho na lâmina (efeito 8-bit) -->
                    <rect x="89" y="12" width="2" height="15" fill="#ffffff" opacity="0.6"/>
                    <rect x="89" y="30" width="2" height="8" fill="#ffffff" opacity="0.4"/>
                </svg>
            </div>

            <div class="logo-title">N.E.X.U.S.</div>
            <div class="logo-acronym">
                <strong>N</strong>úcleo de <strong>E</strong>studos e<br>
                e<strong>X</strong>celência com s<strong>U</strong>porte de<br>
                <strong>S</strong>istema Inteligente
            </div>
            <div class="logo-subtitle">Plataforma de Estudos para Magistratura</div>
        </div>

        <div class="divider"></div>

        <!-- Descrição -->
        <div class="description">
            Sistema integrado de gestão de estudos com inteligência artificial para preparação em concursos de magistratura. Controle total sobre seu aprendizado através de metodologias estruturadas e análise de desempenho.
        </div>

        <!-- Botão de Login -->
        <button class="login-btn" onclick="iniciarLogin()">
            <span class="login-icon">🔐</span>
            Entrar com Google
        </button>

        <!-- Loading -->
        <div class="loading" id="loading">
            <div class="spinner"></div>
            <div class="loading-text">Autenticando...</div>
        </div>

        <!-- Features -->
        <div class="features">
            <div class="feature-item">
                <span class="feature-icon">•</span>
                <span>Registro estruturado por eixos temáticos: Lei Seca, Jurisprudência, Doutrina e Questões</span>
            </div>
            <div class="feature-item">
                <span class="feature-icon">•</span>
                <span>Integração com ChatGPT para geração de flashcards e análise de materiais</span>
            </div>
            <div class="feature-item">
                <span class="feature-icon">•</span>
                <span>Sistema de revisão espaçada com compatibilidade Anki (import/export CSV)</span>
            </div>
            <div class="feature-item">
                <span class="feature-icon">•</span>
                <span>Estatísticas detalhadas de desempenho e métricas de progresso por matéria</span>
            </div>
        </div>

        <!-- Footer -->
        <div class="footer">
            <strong>Desenvolvido por</strong><br>
            Leonardo Costa Parreira Filho<br>
            Gabinete da Comarca de Rialma - GO
            <br><br>
            <strong>N.E.X.U.S. v3.0</strong> © 2025
        </div>
    </div>

    <script>
        // Iniciar login
        function iniciarLogin() {
            document.getElementById('loading').classList.add('active');
            document.querySelector('.login-btn').disabled = true;
            document.querySelector('.login-btn').style.opacity = '0.6';

            google.script.run
                .withSuccessHandler(function(result) {
                    if (result.authenticated) {
                        window.location.reload();
                    } else {
                        alert('Erro ao autenticar. Por favor, tente novamente.');
                        document.getElementById('loading').classList.remove('active');
                        document.querySelector('.login-btn').disabled = false;
                        document.querySelector('.login-btn').style.opacity = '1';
                    }
                })
                .withFailureHandler(function(error) {
                    console.error('Erro:', error);
                    alert('Erro ao conectar. Verifique sua conexão e tente novamente.');
                    document.getElementById('loading').classList.remove('active');
                    document.querySelector('.login-btn').disabled = false;
                    document.querySelector('.login-btn').style.opacity = '1';
                })
                .checkAuthentication();
        }
    </script>
</body>
</html>
